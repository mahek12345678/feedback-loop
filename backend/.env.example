PROJECT_NAME=FeedbackLoop
API_V1_STR=/api
SECRET_KEY=super-secret-feedbackloop-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL URL for production or default SQLite for local dev)
DATABASE_URL=sqlite:///./feedbackloop.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/feedbackloop

# Local Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_API_KEY=

# Privacy & Warning Thresholds
MIN_RESPONSES_FOR_FACULTY_VIEW=3
EARLY_WARNING_DIFFICULTY_THRESHOLD=30.0
EARLY_WARNING_WOW_THRESHOLD=15.0
